# =============================================================================
# MasterPro — environment (PRD §14). Salin ke .env:  cp .env.example .env
# Nilai di bawah AMAN untuk development lokal. Produksi: .env dibuat otomatis oleh
# GitHub Actions dari Secrets/Variables (lihat README.md → GitHub Secrets).
# =============================================================================

# --- Compose ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=masterpro
DOMAIN=localhost
MEDIA_DOMAIN=media.localhost
# Hanya produksi (diisi CI):
IMAGE_REGISTRY=ghcr.io/bidtech-solutions
IMAGE_TAG=latest

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=masterpro
POSTGRES_USER=masterpro
POSTGRES_PASSWORD=masterpro-local-password

# --- Backend (Go) -------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
RUN_MIGRATIONS=true
# Produksi: minimal 64 karakter acak → openssl rand -base64 48
JWT_SECRET=local-development-jwt-secret-change-me-0123456789abcdef0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Isi "cloudflare" bila domain diproksi Cloudflare (IP klien dari CF-Connecting-IP)
TRUSTED_PLATFORM=cloudflare

# --- Object storage (RustFS, S3-compatible) -----------------------------------
S3_ENDPOINT=rustfs:9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=masterpro
S3_SECRET_KEY=masterpro-local-secret
S3_BUCKET=masterpro-media
MEDIA_PUBLIC_URL=http://media.localhost

# --- Integrasi frontend <-> backend -------------------------------------------
FRONTEND_INTERNAL_URL=http://frontend:3000
REVALIDATE_SECRET=local-revalidate-secret-change-me

# --- Seed admin pertama (dipakai: go run ./cmd/seed) --------------------------
SEED_ADMIN_NAME=Admin MasterPro
SEED_ADMIN_EMAIL=admin@masterpro.co.id
SEED_ADMIN_PASSWORD=AdminLokal123

# --- Frontend (Next.js) -------------------------------------------------------
# NEXT_PUBLIC_* di-inline saat build (produksi: build-arg di CI)
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_MEDIA_URL=http://media.localhost
INTERNAL_API_URL=http://backend:8080
